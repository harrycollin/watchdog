{
  "service": {
    "startOnBoot": true
  },
  "notifications": {
    "webhook": {
      "enabled": false,
      "url": "",
      "timeoutSeconds": 10,
      "events": {
        "restartLimitReached": true,
        "error": true,
        "restart": false,
        "unhealthy": false,
        "recovered": false
      },
      "statusReport": {
        "enabled": false,
        "intervalMinutes": 60
      }
    }
  },
  "applications": [
    {
      "id": "kiosk-main",
      "enabled": true,
      "kind": "process",
      "application": {
        "executablePath": "",
        "arguments": "",
        "workingDirectory": "",
        "displayName": "My Kiosk"
      },
      "http": {
        "startCommand": "",
        "stopCommand": "",
        "workingDirectory": ""
      },
      "monitoring": {
        "processCheckIntervalSeconds": 5,
        "healthCheckIntervalSeconds": 10,
        "healthTimeoutSeconds": 45,
        "gracefulTerminationTimeoutSeconds": 10
      },
      "restart": {
        "restartOnExit": true,
        "restartOnUnhealthy": true,
        "restartDelaySeconds": 5,
        "maxRestarts": 5,
        "restartWindowMinutes": 10
      },
      "health": {
        "enabled": false,
        "type": "http",
        "url": "",
        "expectedStatusCode": 200
      },
      "launch": {
        "mode": "interactive"
      },
      "schedule": {
        "enabled": false,
        "startTime": "09:00",
        "endTime": "18:00",
        "daysOfWeek": ["monday", "tuesday", "wednesday", "thursday", "friday"]
      },
      "resources": {
        "enabled": false,
        "maxMemoryMegabytes": 1536,
        "maxCpuPercent": 90,
        "breachDurationSeconds": 300,
        "includeChildProcesses": true
      }
    },
    {
      "id": "local-site",
      "enabled": false,
      "kind": "http",
      "application": {
        "executablePath": "",
        "arguments": "",
        "workingDirectory": "",
        "displayName": "Local website"
      },
      "http": {
        "startCommand": "npm start",
        "stopCommand": "",
        "workingDirectory": "C:\\Sites\\MyApp"
      },
      "monitoring": {
        "processCheckIntervalSeconds": 5,
        "healthCheckIntervalSeconds": 5,
        "healthTimeoutSeconds": 30,
        "gracefulTerminationTimeoutSeconds": 10
      },
      "restart": {
        "restartOnExit": true,
        "restartOnUnhealthy": true,
        "restartDelaySeconds": 5,
        "maxRestarts": 5,
        "restartWindowMinutes": 10
      },
      "health": {
        "enabled": true,
        "type": "http",
