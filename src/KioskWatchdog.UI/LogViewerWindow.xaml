<Window x:Class="KioskWatchdog.LogViewerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Watchdog logs"
        Height="560"
        Width="900"
        MinHeight="400"
        MinWidth="640"
        WindowStartupLocation="CenterOwner"
        Background="#FFF5F5F5">
  <DockPanel Margin="12">
    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,10">
      <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
        <CheckBox x:Name="AutoScrollCheck"
                  Content="Auto-scroll"
                  IsChecked="True"
                  VerticalAlignment="Center"
                  Margin="0,0,12,0"
                  Checked="AutoScrollCheck_Changed"
                  Unchecked="AutoScrollCheck_Changed" />
        <Button Content="Refresh" Padding="10,4" Margin="0,0,8,0" Click="Refresh_Click" />
        <Button Content="Open folder" Padding="10,4" Margin="0,0,8,0" Click="OpenFolder_Click" />
        <Button Content="Close" Padding="10,4" Click="Close_Click" />
      </StackPanel>
      <StackPanel>
        <TextBlock Text="Log history" FontSize="18" FontWeight="SemiBold" />
        <TextBlock Text="Persisted service logs (rolling daily files, kept ~14 days)."
                   Foreground="#FF64748B"
                   Margin="0,2,0,0" />
      </StackPanel>
    </DockPanel>

    <TextBlock x:Name="StatusText"
               DockPanel.Dock="Bottom"
               Margin="0,8,0,0"
               Foreground="#FF666666"
               Text="—" />

    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="200" />
        <ColumnDefinition Width="12" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>

      <Border Grid.Column="0"
              Background="White"
              BorderBrush="#FFDDDDDD"
              BorderThickness="1"
              CornerRadius="4"
              Padding="8">
        <DockPanel>
          <TextBlock DockPanel.Dock="Top" Text="Files" FontWeight="SemiBold" Margin="0,0,0,6" />
          <ListBox x:Name="FileList"
                   BorderThickness="0"
                   SelectionChanged="FileList_SelectionChanged">
            <ListBox.ItemTemplate>
              <DataTemplate>
                <StackPanel Margin="2,4">
                  <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                  <TextBlock FontSize="11" Foreground="#FF64748B"
                             Text="{Binding LastWriteTime, StringFormat={}{0:g}}" />
                </StackPanel>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </DockPanel>
      </Border>

      <DockPanel Grid.Column="2">
        <TextBox x:Name="FilterBox"
                 DockPanel.Dock="Top"
                 Margin="0,0,0,8"
                 Padding="6,4"
                 TextChanged="FilterBox_TextChanged"
                 ToolTip="Filter lines (case-insensitive)" />
        <Border Background="White"
                BorderBrush="#FFDDDDDD"
                BorderThickness="1"
                CornerRadius="4"
                Padding="0">
          <TextBox x:Name="LogText"
                   IsReadOnly="True"
                   TextWrapping="NoWrap"
                   AcceptsReturn="True"
                   VerticalScrollBarVisibility="Auto"
                   HorizontalScrollBarVisibility="Auto"
                   FontFamily="Consolas"
                   FontSize="12"
                   BorderThickness="0"
                   Padding="10"
                   Background="Transparent" />
        </Border>
      </DockPanel>
    </Grid>
  </DockPanel>
</Window>
