<Window x:Class="KioskWatchdog.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Kiosk Watchdog"
        Height="720"
        Width="980"
        MinHeight="560"
        MinWidth="820"
        WindowStartupLocation="CenterScreen"
        Background="#FFF5F5F5"
        Closing="Window_Closing">
  <DockPanel Margin="16">
    <StackPanel DockPanel.Dock="Top" Margin="0,0,0,12">
      <DockPanel>
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
          <Border x:Name="StatusChip"
                  Background="#FFE5E7EB"
                  CornerRadius="4"
                  Padding="10,4"
                  Margin="0,0,8,0">
            <TextBlock x:Name="StatusChipText" Text="—" FontWeight="SemiBold" FontSize="12" />
          </Border>
          <Button Content="Open logs" Padding="10,4" Click="OpenLogs_Click" />
        </StackPanel>
        <StackPanel>
          <TextBlock Text="Kiosk Watchdog" FontSize="26" FontWeight="SemiBold" />
          <TextBlock Text="Configure watched targets. Close minimizes to the system tray."
                     Foreground="#FF64748B"
                     Margin="0,4,0,0"
                     TextWrapping="Wrap" />
        </StackPanel>
      </DockPanel>
    </StackPanel>

    <StatusBar DockPanel.Dock="Bottom" Margin="0,12,0,0" Background="Transparent">
      <StatusBarItem>
        <TextBlock x:Name="FooterText" Text="Ready" Foreground="#FF666666" />
      </StatusBarItem>
    </StatusBar>

    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="260" />
        <ColumnDefinition Width="12" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>

      <!-- App list -->
      <Border Grid.Column="0"
              Background="White"
              BorderBrush="#FFDDDDDD"
              BorderThickness="1"
              Padding="10"
              CornerRadius="4">
        <DockPanel>
          <TextBlock DockPanel.Dock="Top"
                     Text="Applications"
                     FontWeight="SemiBold"
                     Margin="0,0,0,8" />
          <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,8,0,0">
            <Button Content="Add" Width="70" Margin="0,0,6,0" Click="AddApp_Click" />
            <Button Content="Remove" Width="70" Click="RemoveApp_Click" />
          </StackPanel>
          <ListBox x:Name="AppList"
                   SelectionChanged="AppList_SelectionChanged"
                   BorderThickness="0"
                   Background="Transparent">
            <ListBox.ItemTemplate>
              <DataTemplate>
                <StackPanel Margin="4,6">
                  <TextBlock FontWeight="SemiBold" Text="{Binding DisplayName}" />
                  <TextBlock FontSize="11" Foreground="#FF64748B" Text="{Binding KindLabel}" />
                </StackPanel>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </DockPanel>
      </Border>

      <!-- Selected app detail -->
      <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto">
        <StackPanel>
          <Border Background="White"
                  BorderBrush="#FFDDDDDD"
                  BorderThickness="1"
                  Padding="14"
                  CornerRadius="4"
                  Margin="0,0,0,12">
            <StackPanel>
              <TextBlock Text="Live status" FontWeight="SemiBold" Margin="0,0,0,8" />
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" Margin="0,0,8,6">
                  <Run FontWeight="SemiBold" Text="Status: " />
                  <Run x:Name="StatusValue" Text="—" />
                </TextBlock>
                <TextBlock Grid.Row="0" Grid.Column="1" Margin="0,0,0,6">
                  <Run FontWeight="SemiBold" Text="PID: " />
                  <Run x:Name="PidValue" Text="—" />
                </TextBlock>
                <TextBlock Grid.Row="1" Grid.Column="0" Margin="0,0,8,6">
                  <Run FontWeight="SemiBold" Text="Restarts: " />
                  <Run x:Name="RestartValue" Text="—" />
                </TextBlock>
                <TextBlock Grid.Row="1" Grid.Column="1" Margin="0,0,0,6">
                  <Run FontWeight="SemiBold" Text="Last start: " />
                  <Run x:Name="LastStartValue" Text="—" />
                </TextBlock>
                <TextBlock Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2" Margin="0,0,0,6" TextWrapping="Wrap">
                  <Run FontWeight="SemiBold" Text="Health: " />
                  <Run x:Name="HealthValue" Text="—" />
                </TextBlock>
                <TextBlock Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="2" TextWrapping="Wrap">
                  <Run FontWeight="SemiBold" Text="Message: " />
                  <Run x:Name="MessageValue" Text="—" />
                </TextBlock>
              </Grid>

              <WrapPanel Margin="0,12,0,0">
                <Button Content="Start" Width="90" Margin="0,0,8,8" Click="Start_Click" />
                <Button Content="Stop" Width="90" Margin="0,0,8,8" Click="Stop_Click" />
                <Button Content="Restart" Width="90" Margin="0,0,8,8" Click="Restart_Click" />
                <Button Content="Reset Counter" Width="110" Margin="0,0,8,8" Click="ResetCounter_Click" />
                <Button Content="Test Health" Width="100" Margin="0,0,8,8" Click="TestHealth_Click" />
              </WrapPanel>
            </StackPanel>
          </Border>

          <Border Background="White"
                  BorderBrush="#FFDDDDDD"
                  BorderThickness="1"
                  Padding="14"
                  CornerRadius="4"
                  Margin="0,0,0,12">
            <StackPanel>
              <TextBlock Text="Webhook notifications" FontWeight="SemiBold" Margin="0,0,0,4" />
              <TextBlock Text="Machine-wide. Sent by the service in the background (does not block monitoring)."
                         Foreground="#FF666666"
                         Margin="0,0,0,10"
                         TextWrapping="Wrap" />

              <CheckBox x:Name="WebhookEnabledCheck" Content="Enable webhook events" Margin="0,0,0,8" />

              <Grid Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="140" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" Text="Webhook URL" VerticalAlignment="Center" Margin="0,0,0,8" />
                <TextBox x:Name="WebhookUrlBox" Grid.Row="0" Grid.Column="1" Margin="0,0,0,8"
                         ToolTip="https://example.com/hooks/watchdog" />

                <TextBlock Grid.Row="1" Grid.Column="0" Text="Timeout (s)" VerticalAlignment="Center" />
                <TextBox x:Name="WebhookTimeoutBox" Grid.Row="1" Grid.Column="1" Width="80" HorizontalAlignment="Left" Text="10" />
              </Grid>

              <TextBlock Text="Events" FontWeight="SemiBold" Margin="0,4,0,6" />
              <WrapPanel Margin="0,0,0,8">
                <CheckBox x:Name="EventRestartLimitCheck" Content="Restart limit reached" Margin="0,0,16,6" IsChecked="True" />
                <CheckBox x:Name="EventErrorCheck" Content="Error" Margin="0,0,16,6" IsChecked="True" />
                <CheckBox x:Name="EventRestartCheck" Content="Restart" Margin="0,0,16,6" />
                <CheckBox x:Name="EventUnhealthyCheck" Content="Unhealthy" Margin="0,0,16,6" />
                <CheckBox x:Name="EventRecoveredCheck" Content="Recovered" Margin="0,0,16,6" />
              </WrapPanel>

              <Separator Margin="0,4,0,10" />

              <CheckBox x:Name="StatusReportEnabledCheck" Content="Periodic status report (all watches)" Margin="0,0,0,8" />
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="140" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="Interval (min)" VerticalAlignment="Center" />
                <TextBox x:Name="StatusReportIntervalBox" Grid.Column="1" Width="80" HorizontalAlignment="Left" Text="60" />
              </Grid>
            </StackPanel>
          </Border>

          <Border Background="White"
                  BorderBrush="#FFDDDDDD"
                  BorderThickness="1"
                  Padding="14"
                  CornerRadius="4">
            <StackPanel>
              <TextBlock Text="Configuration" FontWeight="SemiBold" Margin="0,0,0,10" />

              <Grid Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="140" />
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" Text="Id" VerticalAlignment="Center" Margin="0,0,0,8" />
                <TextBox x:Name="AppIdBox" Grid.Row="0" Grid.Column="1" Margin="0,0,0,8" LostFocus="AppIdBox_LostFocus" />

                <TextBlock Grid.Row="1" Grid.Column="0" Text="Enabled" VerticalAlignment="Center" Margin="0,0,0,8" />
                <CheckBox x:Name="EnabledCheck" Grid.Row="1" Grid.Column="1" VerticalAlignment="Center" Margin="0,0,0,8"
                          Checked="EnabledCheck_Changed" Unchecked="EnabledCheck_Changed" />

                <TextBlock Grid.Row="2" Grid.Column="0" Text="Display name" VerticalAlignment="Center" Margin="0,0,0,8" />
                <TextBox x:Name="DisplayNameBox" Grid.Row="2" Grid.Column="1" Margin="0,0,0,8" />

                <TextBlock Grid.Row="3" Grid.Column="0" Text="Type" VerticalAlignment="Center" Margin="0,0,0,8" />
                <ComboBox x:Name="KindBox" Grid.Row="3" Grid.Column="1" Margin="0,0,0,8"
                          SelectionChanged="KindBox_SelectionChanged">
                  <ComboBoxItem Content="Process (.exe)" Tag="Process" />
                  <ComboBoxItem Content="HTTP / website" Tag="Http" />
                  <ComboBoxItem Content="TCP port" Tag="Tcp" />
                  <ComboBoxItem Content="Windows Service" Tag="WindowsService" />
                </ComboBox>
              </Grid>

              <StackPanel x:Name="ProcessFieldsPanel">
                <Grid Margin="0,0,0,8">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="140" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                  </Grid.RowDefinitions>

                  <TextBlock Grid.Row="0" Grid.Column="0" Text="Executable" VerticalAlignment="Center" Margin="0,0,0,8" />
                  <TextBox x:Name="ExecutableBox" Grid.Row="0" Grid.Column="1" Margin="0,0,8,8" />
                  <Button Grid.Row="0" Grid.Column="2" Content="Browse…" Width="80" Margin="0,0,0,8" Click="BrowseExecutable_Click" />

                  <TextBlock Grid.Row="1" Grid.Column="0" Text="Arguments" VerticalAlignment="Center" Margin="0,0,0,8" />
                  <TextBox x:Name="ArgumentsBox" Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Margin="0,0,0,8" />

                  <TextBlock Grid.Row="2" Grid.Column="0" Text="Working directory" VerticalAlignment="Center" Margin="0,0,0,8" />
                  <TextBox x:Name="WorkingDirBox" Grid.Row="2" Grid.Column="1" Margin="0,0,8,8" />
                  <Button Grid.Row="2" Grid.Column="2" Content="Browse…" Width="80" Margin="0,0,0,8" Click="BrowseWorkingDir_Click" />

                  <TextBlock Grid.Row="3" Grid.Column="0" Text="Launch mode" VerticalAlignment="Center" Margin="0,0,0,8" />
                  <ComboBox x:Name="LaunchModeBox" Grid.Row="3" Grid.Column="1" Margin="0,0,0,8"
                            SelectedIndex="0">
                    <ComboBoxItem Content="Interactive" Tag="Interactive" />
                    <ComboBoxItem Content="Service" Tag="Service" />
                  </ComboBox>
                </Grid>
              </StackPanel>

              <StackPanel x:Name="HttpFieldsPanel" Visibility="Collapsed">
                <TextBlock Text="HTTP liveness via health URL. Optional start/stop shell commands for recovery."
                           Foreground="#FF666666" Margin="0,0,0,8" TextWrapping="Wrap" />
                <Grid Margin="0,0,0,8">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="140" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                  </Grid.RowDefinitions>

                  <TextBlock Grid.Row="0" Grid.Column="0" Text="Start command" VerticalAlignment="Center" Margin="0,0,0,8" />
                  <TextBox x:Name="StartCommandBox" Grid.Row="0" Grid.Column="1" Grid.ColumnSpan="2" Margin="0,0,0,8"
                           ToolTip="Optional. e.g. npm start — leave empty for probe-only." />

                  <TextBlock Grid.Row="1" Grid.Column="0" Text="Stop command" VerticalAlignment="Center" Margin="0,0,0,8" />
                  <TextBox x:Name="StopCommandBox" Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Margin="0,0,0,8"
                           ToolTip="Optional. If empty, kills the started command process tree." />

                  <TextBlock Grid.Row="2" Grid.Column="0" Text="Working directory" VerticalAlignment="Center" Margin="0,0,0,8" />
                  <TextBox x:Name="HttpWorkingDirBox" Grid.Row="2" Grid.Column="1" Margin="0,0,8,8" />
                  <Button Grid.Row="2" Grid.Column="2" Content="Browse…" Width="80" Margin="0,0,0,8" Click="BrowseHttpWorkingDir_Click" />

                  <TextBlock Grid.Row="3" Grid.Column="0" Text="Launch mode" VerticalAlignment="Center" Margin="0,0,0,8" />
                  <ComboBox x:Name="HttpLaunchModeBox" Grid.Row="3" Grid.Column="1" Margin="0,0,0,8"
                            SelectedIndex="0">
                    <ComboBoxItem Content="Interactive" Tag="Interactive" />
                    <ComboBoxItem Content="Service" Tag="Service" />
                  </ComboBox>
                </Grid>
              </StackPanel>

              <StackPanel x:Name="TcpFieldsPanel" Visibility="Collapsed">
                <TextBlock Text="TCP port check on localhost. Optional start/stop commands for recovery."
                           Foreground="#FF666666" Margin="0,0,0,8" TextWrapping="Wrap" />
                <Grid Margin="0,0,0,8">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="140" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                  </Grid.RowDefinitions>

                  <TextBlock Grid.Row="0" Grid.Column="0" Text="Host" VerticalAlignment="Center" Margin="0,0,0,8" />
                  <TextBox x:Name="TcpHostBox" Grid.Row="0" Grid.Column="1" Grid.ColumnSpan="2" Margin="0,0,0,8" Text="127.0.0.1" />

                  <TextBlock Grid.Row="1" Grid.Column="0" Text="Port" VerticalAlignment="Center" Margin="0,0,0,8" />
                  <TextBox x:Name="TcpPortBox" Grid.Row="1" Grid.Column="1" Margin="0,0,0,8" />

                  <TextBlock Grid.Row="2" Grid.Column="0" Text="Start command" VerticalAlignment="Center" Margin="0,0,0,8" />
                  <TextBox x:Name="TcpStartCommandBox" Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2" Margin="0,0,0,8" />

                  <TextBlock Grid.Row="3" Grid.Column="0" Text="Stop command" VerticalAlignment="Center" Margin="0,0,0,8" />
                  <TextBox x:Name="TcpStopCommandBox" Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="2" Margin="0,0,0,8" />

                  <TextBlock Grid.Row="4" Grid.Column="0" Text="Working directory" VerticalAlignment="Center" Margin="0,0,0,8" />
                  <TextBox x:Name="TcpWorkingDirBox" Grid.Row="4" Grid.Column="1" Margin="0,0,8,8" />
                  <Button Grid.Row="4" Grid.Column="2" Content="Browse…" Width="80" Margin="0,0,0,8" Click="BrowseTcpWorkingDir_Click" />
                </Grid>
              </StackPanel>

              <StackPanel x:Name="ServiceFieldsPanel" Visibility="Collapsed">
                <TextBlock Text="Monitor and restart a Windows Service by name."
                           Foreground="#FF666666" Margin="0,0,0,8" TextWrapping="Wrap" />
                <Grid Margin="0,0,0,8">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="140" />
                    <ColumnDefinition Width="*" />
                  </Grid.ColumnDefinitions>
                  <TextBlock Grid.Column="0" Text="Service name" VerticalAlignment="Center" />
                  <TextBox x:Name="ServiceNameBox" Grid.Column="1" ToolTip="e.g. Spooler or your service name" />
                </Grid>
              </StackPanel>

              <Separator Margin="0,4,0,12" />

              <TextBlock Text="Monitoring" FontWeight="SemiBold" Margin="0,0,0,8" />
              <Grid Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="160" />
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="160" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" Text="Process check (s)" VerticalAlignment="Center" Margin="0,0,8,8" />
                <TextBox x:Name="ProcessIntervalBox" Grid.Row="0" Grid.Column="1" Margin="0,0,16,8" />
                <TextBlock Grid.Row="0" Grid.Column="2" Text="Health interval (s)" VerticalAlignment="Center" Margin="0,0,8,8" />
                <TextBox x:Name="HealthIntervalBox" Grid.Row="0" Grid.Column="3" Margin="0,0,0,8" />

                <TextBlock Grid.Row="1" Grid.Column="0" Text="Health timeout (s)" VerticalAlignment="Center" Margin="0,0,8,8" />
                <TextBox x:Name="HealthTimeoutBox" Grid.Row="1" Grid.Column="1" Margin="0,0,16,8" />
                <TextBlock Grid.Row="1" Grid.Column="2" Text="Graceful stop (s)" VerticalAlignment="Center" Margin="0,0,8,8" />
                <TextBox x:Name="GracefulStopBox" Grid.Row="1" Grid.Column="3" Margin="0,0,0,8" />
              </Grid>

              <Separator Margin="0,4,0,12" />

              <TextBlock Text="Restart" FontWeight="SemiBold" Margin="0,0,0,8" />
              <Grid Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="160" />
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="160" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Grid.Column="0" Text="Restart delay (s)" VerticalAlignment="Center" Margin="0,0,8,8" />
                <TextBox x:Name="RestartDelayBox" Grid.Row="0" Grid.Column="1" Margin="0,0,16,8" />
                <TextBlock Grid.Row="0" Grid.Column="2" Text="Max restarts" VerticalAlignment="Center" Margin="0,0,8,8" />
                <TextBox x:Name="MaxRestartsBox" Grid.Row="0" Grid.Column="3" Margin="0,0,0,8" />
                <TextBlock Grid.Row="1" Grid.Column="0" Text="Window (min)" VerticalAlignment="Center" Margin="0,0,8,0" />
                <TextBox x:Name="RestartWindowBox" Grid.Row="1" Grid.Column="1" Margin="0,0,16,0" />
              </Grid>

              <Separator Margin="0,12,0,12" />

              <TextBlock Text="Health check" FontWeight="SemiBold" Margin="0,0,0,8" />
              <CheckBox x:Name="HealthEnabledCheck" Content="Enable HTTP health check" Margin="0,0,0,8" />
              <TextBlock x:Name="HttpHealthHint"
                         Text="Required for HTTP apps — used as liveness (site up / down)."
                         Foreground="#FF666666"
                         Margin="0,0,0,8"
                         Visibility="Collapsed"
                         TextWrapping="Wrap" />
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="140" />
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="140" />
                  <ColumnDefinition Width="80" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="Health URL" VerticalAlignment="Center" Margin="0,0,8,0" />
                <TextBox x:Name="HealthUrlBox" Grid.Column="1" Margin="0,0,16,0" />
                <TextBlock Grid.Column="2" Text="Expected status" VerticalAlignment="Center" Margin="0,0,8,0" />
                <TextBox x:Name="ExpectedStatusBox" Grid.Column="3" Text="200" />
              </Grid>

              <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                <Button Content="Save configuration" Width="150" Margin="0,0,8,0" Click="Save_Click"
                        Background="#FF2563EB" Foreground="White" FontWeight="SemiBold" Padding="8,4" />
                <Button Content="Reload" Width="90" Click="Reload_Click" />
              </StackPanel>
            </StackPanel>
          </Border>
        </StackPanel>
      </ScrollViewer>
    </Grid>
  </DockPanel>
</Window>
