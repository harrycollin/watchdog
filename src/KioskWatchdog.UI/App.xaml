<Application x:Class="KioskWatchdog.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="MainWindow.xaml">
  <Application.Resources>
    <SolidColorBrush x:Key="BgBrush" Color="#F3F5F7"/>
    <SolidColorBrush x:Key="PanelBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="TextBrush" Color="#1B242C"/>
    <SolidColorBrush x:Key="MutedBrush" Color="#5B6B7C"/>
    <SolidColorBrush x:Key="AccentBrush" Color="#0F6E56"/>
    <SolidColorBrush x:Key="DangerBrush" Color="#B42318"/>
    <SolidColorBrush x:Key="WarnBrush" Color="#B54708"/>
    <SolidColorBrush x:Key="BorderBrush" Color="#D0D7DE"/>
  </Application.Resources>
</Application>
